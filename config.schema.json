{
  "pluginAlias": "OtodoVavPlatform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "OtodoVavPlatform"
      },
      "email": {
        "title": "Email (VAV)",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "Password (VAV)",
        "type": "string",
        "format": "password"
      },
      "parkname": {
        "title": "Park name",
        "type": "string",
        "default": "vav"
      },
      "homeId": {
        "title": "Home ID (optional)",
        "type": "string"
      },
      "pollIntervalSec": {
        "title": "Polling interval (seconds)",
        "type": "number",
        "default": 30
      },
      "debug": {
        "title": "Verbose logging",
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "email",
      "password"
    ]
  }
}